{
  "name": "@motion-agent/remotion-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "compositions": "remotion compositions src/index.ts",
    "render:demo": "remotion render src/index.ts MotionAgentDemo out/motion-agent-demo.mp4",
    "render:job": "remotion render src/index.ts MotionJobPreview out/motion-job-preview.mp4 --props=jobs/example-job.json",
    "render:scene": "remotion render src/index.ts MotionScene out/motion-scene.mp4 --props=jobs/scene-job.json",
    "typecheck": "tsc --noEmit",
    "render:adsmagic": "remotion render src/index.ts AdsmagicClickToSale out/adsmagic-do-clique-a-venda.mp4",
    "assets:scene1": "node scripts/reconstruct-scene1-assets.mjs",
    "studio:scene1": "pnpm run assets:scene1 && remotion studio src/index.ts",
    "render:scene1": "pnpm run assets:scene1 && remotion render src/index.ts AdsmagicScene1Layered out/adsmagic-scene1-layered.mp4",
    "still:scene1": "pnpm run assets:scene1 && remotion still src/index.ts AdsmagicScene1Layered out/adsmagic-scene1-layered-still.png --frame=30"
  },
  "dependencies": {
    "@motion-agent/runtime": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.525",
    "@react-three/fiber": "9.2.0",
    "@remotion/three": "4.0.525",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.525",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "@types/three": "0.170.0"
  }
}
