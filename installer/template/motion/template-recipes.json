{
  "schemaVersion": 1,
  "lastReviewed": "2026-09-18",
  "catalog": "https://www.remotion.dev/templates",
  "policy": {
    "sourceOfTruth": "official-remotion-template-catalog",
    "defaultTemplate": "blank",
    "preserveHostProjectSource": true,
    "templatesAreTechniqueReferencesNotVisualStyle": true,
    "neverBypassLayerabilityGate": true,
    "neverReplaceApprovedBrandOrUIWithTemplateVisuals": true,
    "scaffoldOnlyInsideIsolatedMotionWorkspaceUnlessUserExplicitlyRequestsOtherwise": true
  },
  "templates": [
    {
      "id": "blank",
      "name": "Blank",
      "page": "https://www.remotion.dev/templates/blank",
      "command": "pnpm create video --blank",
      "role": "general-product-motion",
      "useWhen": [
        "custom React motion",
        "AI-authored motion",
        "existing product UI",
        "no specialized runtime needed"
      ],
      "avoidWhen": [
        "specialized 3D, Skia, captions or audio visualization is clearly required"
      ]
    },
    {
      "id": "hello-world",
      "name": "Hello World",
      "page": "https://www.remotion.dev/templates/hello-world",
      "command": "pnpm create video --hello-world",
      "role": "learning-baseline",
      "useWhen": [
        "basic Remotion playground",
        "learning or minimal demo"
      ],
      "avoidWhen": [
        "production product motion where Blank is sufficient"
      ]
    },
    {
      "id": "next",
      "name": "Next.js",
      "page": "https://www.remotion.dev/templates/next",
      "command": "pnpm create video --next",
      "role": "video-generation-app",
      "useWhen": [
        "Next.js app that generates videos",
        "Remotion Player plus rendering app"
      ],
      "avoidWhen": [
        "single motion composition inside an existing product repository"
      ]
    },
    {
      "id": "vercel",
      "name": "Next.js (Vercel Sandbox)",
      "page": "https://www.remotion.dev/templates/vercel",
      "command": "pnpm create video --vercel",
      "role": "vercel-sandbox-rendering",
      "useWhen": [
        "on-demand rendering through Vercel Sandbox"
      ],
      "avoidWhen": [
        "local product motion only"
      ]
    },
    {
      "id": "next-no-tailwind",
      "name": "Next.js (No Tailwind)",
      "page": "https://www.remotion.dev/templates/next-no-tailwind",
      "command": "pnpm create video --next-no-tailwind",
      "role": "video-generation-app",
      "useWhen": [
        "Next.js video app without Tailwind"
      ],
      "avoidWhen": [
        "single motion composition"
      ]
    },
    {
      "id": "next-pages-dir",
      "name": "Next.js (Pages dir)",
      "page": "https://www.remotion.dev/templates/next-pages-dir",
      "command": "pnpm create video --next-pages-dir",
      "role": "legacy-next-video-app",
      "useWhen": [
        "Next.js Pages Router video app"
      ],
      "avoidWhen": [
        "App Router or standalone motion"
      ]
    },
    {
      "id": "recorder",
      "name": "Recorder",
      "page": "https://www.remotion.dev/templates/recorder",
      "command": "pnpm create video --recorder",
      "role": "browser-recorder",
      "useWhen": [
        "browser-based video recording or production tool"
      ],
      "avoidWhen": [
        "ordinary motion graphics"
      ]
    },
    {
      "id": "prompt-to-motion-graphics",
      "name": "Prompt to Motion Graphics SaaS Starter Kit",
      "page": "https://www.remotion.dev/templates/prompt-to-motion-graphics",
      "command": "pnpm create video --prompt-to-motion-graphics",
      "role": "ai-motion-generation-app",
      "useWhen": [
        "prompt-to-motion product",
        "streaming generated Remotion code to a browser preview"
      ],
      "avoidWhen": [
        "directed product film with approved art direction"
      ]
    },
    {
      "id": "javascript",
      "name": "Hello World (JavaScript)",
      "page": "https://www.remotion.dev/templates/javascript",
      "command": "pnpm create video --javascript",
      "role": "javascript-baseline",
      "useWhen": [
        "plain JavaScript is explicitly required"
      ],
      "avoidWhen": [
        "TypeScript project"
      ]
    },
    {
      "id": "render-server",
      "name": "Render Server",
      "page": "https://www.remotion.dev/templates/render-server",
      "command": "pnpm create video --render-server",
      "role": "express-render-service",
      "useWhen": [
        "Express.js render server"
      ],
      "avoidWhen": [
        "local-only motion"
      ]
    },
    {
      "id": "electron",
      "name": "Electron",
      "page": "https://www.remotion.dev/templates/electron",
      "command": "pnpm create video --electron",
      "role": "desktop-render-app",
      "useWhen": [
        "desktop app that renders Remotion video"
      ],
      "avoidWhen": [
        "web or local composition only"
      ]
    },
    {
      "id": "react-router",
      "name": "React Router",
      "page": "https://www.remotion.dev/templates/react-router",
      "command": "pnpm create video --react-router",
