      ]
    },
    {
      "id": "three",
      "name": "React Three Fiber",
      "page": "https://www.remotion.dev/templates/three",
      "sourceRepo": "https://github.com/remotion-dev/template-three",
      "command": "pnpm create video --three",
      "role": "3d-spatial-motion",
      "useWhen": [
        "true 3D geometry",
        "3D camera",
        "React Three Fiber",
        "spatial product mockups",
        "depth that requires actual 3D"
      ],
      "avoidWhen": [
        "using 3D only to fake separation of a flattened styleframe",
        "simple 2D layer motion"
      ]
    },
    {
      "id": "still",
      "name": "Still images",
      "page": "https://www.remotion.dev/templates/still",
      "command": "pnpm create video --still",
      "role": "dynamic-stills",
      "useWhen": [
        "dynamic PNG or JPEG generation"
      ],
      "avoidWhen": [
        "time-based video motion is required"
      ]
    },
    {
      "id": "audiogram",
      "name": "Audiogram",
      "page": "https://www.remotion.dev/templates/audiogram",
      "sourceRepo": "https://github.com/remotion-dev/template-audiogram",
      "command": "pnpm create video --audiogram",
      "role": "podcast-social-video",
      "useWhen": [
