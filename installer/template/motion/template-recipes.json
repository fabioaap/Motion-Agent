      ]
    },
    {
      "id": "music-visualization",
      "name": "Music Visualization",
      "page": "https://www.remotion.dev/templates/music-visualization",
      "sourceRepo": "https://github.com/remotion-dev/template-music-visualization",
      "command": "pnpm create video --music-visualization",
