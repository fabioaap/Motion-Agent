{
  "name": "@fabioaap/motion-agent",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "motion-agent": "bin/motion-agent.mjs"
  },
  "files": [
    "bin",
    "installer",
    "skills/custom",
    "squads",
    "README.md"
  ],
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm --filter @motion-agent/runtime demo",
    "demo:command": "pnpm --filter @motion-agent/runtime demo:command",
    "studio": "pnpm --filter @motion-agent/remotion-studio studio",
    "render:demo": "pnpm --filter @motion-agent/remotion-studio render:demo",
    "render:job": "pnpm --filter @motion-agent/remotion-studio render:job",
    "render:scene": "pnpm --filter @motion-agent/remotion-studio render:scene",
    "motion": "pnpm --filter @motion-agent/cli start",
    "tools:smoke": "pnpm --filter @motion-agent/node-tools smoke",
    "installer:smoke": "node installer/smoke.mjs",
    "installer:package-smoke": "node installer/package-smoke.mjs",
    "skills:remotion": "node scripts/install-remotion-skills.mjs",
    "squad:validate": "node scripts/validate-motion-squad.mjs && node packages/runtime/node_modules/tsx/dist/cli.mjs packages/runtime/examples/layerability-adversarial.ts"
  }
}
